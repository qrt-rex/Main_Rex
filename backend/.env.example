# Rexera HR Management System Configuration

# Application
APP_NAME=Rexera HR Management System
APP_ENV=development
DEBUG=False
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Database (PostgreSQL)
POSTGRES_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/rexera_hr

# Authentication & Security
JWT_SECRET_KEY=rexera_super_secure_jwt_secret_key_2026_random_string_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=10

# Google Authentication (OAuth 2.0)
GOOGLE_CLIENT_ID=1043956921196-h9hblrg0n1tvrk8tmtsvl5lq8njq5okj.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=


# Default Initial Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@rexera.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_USERNAME=admin

# Email / SMTP Configuration (Hostinger). Set EMAIL_DEV_MODE=False and SMTP_PASSWORD to actually send.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@hr.rexera.in
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@hr.rexera.in
SMTP_FROM_NAME=Rexera HR Portal
EMAIL_DEV_MODE=False
# Set to send mail over HTTPS instead of SMTP (needed on hosts that block SMTP, like Render)
BREVO_API_KEY=

# Company Details
COMPANY_NAME=Rexera Technologies Inc.
COMPANY_ADDRESS=Plot No. 42, Cyber Gateway, HITEC City, Hyderabad, Telangana 500081
COMPANY_PHONE=+91 40 4852 9000
COMPANY_EMAIL=hr@rexera.com
COMPANY_WEBSITE=https://www.rexera.com

# IVR / dialer provider (the Sales dialer signs in to it through the CRM at /api/ivr/*)
# Base address of the IVR's API, e.g. https://api.your-ivr-provider.com
IVR_API_BASE_URL=
IVR_LOGIN_PATH=/api/auth/login
IVR_REFRESH_PATH=/api/auth/refresh
IVR_CLIENT_APP=dialer
# Optional JSON overrides for data paths: me, campaigns, cdr, lead-lists, agent-groups, dispositions, dids, call, campaign-action
# IVR_PATHS={"campaigns": "/api/ivr/campaigns", "cdr": "/api/cdr", "call": "/api/dialer/call"}
